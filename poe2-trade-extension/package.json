{
  "name": "poe2-trade-extension",
  "version": "1.0.0",
  "scripts": {
    "build": "npm run build:content:dev && npm run build:background:dev",
    "build:content:dev": "vite build --mode dev-content",
    "build:background:dev": "vite build --mode dev-background",
    "build:prod": "npm run build:content:prod && npm run build:background:prod",
    "build:content:prod": "vite build --mode prod-content",
    "build:background:prod": "vite build --mode prod-background",
    "dev": "vite build --watch"
  },
  "dependencies": {},
  "devDependencies": {
    "terser": "^5.0.0",
    "vite": "^6.0.0"
  }
}
